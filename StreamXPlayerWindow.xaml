<Window x:Class="StreamX.Windows.StreamXPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="StreamX Player" Width="1280" Height="760" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#050507" Foreground="#F7F7F8"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="PlayerButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#24242C"/><Setter Property="BorderBrush" Value="#41414B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A1118"/><Setter Property="BorderBrush" Value="#E50914"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#141418"/><Setter Property="BorderBrush" Value="#55474750"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#19191F"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="#41414B"/><Setter Property="Padding" Value="5,3"/></Style>
  </Window.Resources>
  <Grid Background="#050507">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="142"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0C0C11" BorderBrush="#24242A" BorderThickness="0,0,0,1" Padding="24,0">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <Button x:Name="CloseButton" Content="×" Width="40" Height="38" DockPanel.Dock="Right" Click="CloseButton_Click" Style="{StaticResource OverlayButton}" FontSize="25"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="S T R E A M" Foreground="#F7F7F8" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="X" Foreground="#E50914" FontSize="17" FontWeight="Bold" Margin="5,0,18,0" VerticalAlignment="Center"/>
          <Border Width="1" Height="24" Background="#33333D" Margin="0,0,16,0"/>
          <TextBlock x:Name="TitleText" Text="Now playing" Foreground="#B7B7BE" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#000000" ClipToBounds="True">
      <lvs:VideoView x:Name="VideoView" Background="#000000"/>
    </Border>
    <Border Grid.Row="2" Background="#0C0C11" BorderBrush="#24242A" BorderThickness="0,1,0,0" Padding="22,12,22,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="44"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
          <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#F7F7F8" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock x:Name="DurationText" Text="--:--" Foreground="#A9A9B3" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
          <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0" Margin="14,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" ValueChanged="SeekSlider_ValueChanged"/>
        </DockPanel>
        <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <Button x:Name="BackButton" Content="−10s" Click="BackButton_Click" Style="{StaticResource PlayerButton}" Margin="0,0,8,0"/>
            <Button x:Name="PlayPauseButton" Content="Ⅱ  Pause" Click="PlayPauseButton_Click" Style="{StaticResource PlayerButton}" Margin="0,0,8,0"/>
            <Button x:Name="ForwardButton" Content="+10s" Click="ForwardButton_Click" Style="{StaticResource PlayerButton}" Margin="0,0,18,0"/>
            <TextBlock Text="Volume" Foreground="#D7D7DD" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <Slider x:Name="VolumeSlider" Width="112" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Audio" Foreground="#A9A9B3" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
            <ComboBox x:Name="AudioTracksCombo" Width="150" Height="32" Margin="0,0,14,0" SelectionChanged="AudioTracksCombo_SelectionChanged"/>
            <TextBlock Text="Subtitles" Foreground="#A9A9B3" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
            <ComboBox x:Name="SubtitlesCombo" Width="150" Height="32" Margin="0,0,14,0" SelectionChanged="SubtitlesCombo_SelectionChanged"/>
            <Button x:Name="FullscreenButton" Content="Fullscreen" Click="FullscreenButton_Click" Style="{StaticResource PlayerButton}"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="2" LastChildFill="True">
          <TextBlock Text="ESC Close · SPACE Play/Pause · ←/→ Seek 10 sec · F Fullscreen" FontSize="10" Foreground="#777781" VerticalAlignment="Center" DockPanel.Dock="Right"/>
          <TextBlock x:Name="StatusText" Text="Opening stream…" Foreground="#ACACB5" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
